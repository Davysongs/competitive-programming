{
  "io_mode": "json-stdio",
  "comparison": "exact",
  "float_tolerance": 0.0001,
  "tests": [
    {
      "name": "example1",
      "description": "Two equal packets, no checkpoints. Both in one segment.",
      "input": {
        "n": 2,
        "k": 0,
        "packets": [
          [
            10,
            0.5
          ],
          [
            10,
            0.5
          ]
        ]
      },
      "expected_output": 60.0
    },
    {
      "name": "example2",
      "description": "Two equal packets with one checkpoint. Each packet its own segment.",
      "input": {
        "n": 2,
        "k": 1,
        "packets": [
          [
            10,
            0.5
          ],
          [
            10,
            0.5
          ]
        ]
      },
      "expected_output": 40.0
    },
    {
      "name": "example3",
      "description": "Two packets with different ratios. Sorting determines optimal order.",
      "input": {
        "n": 2,
        "k": 0,
        "packets": [
          [
            5,
            0.1
          ],
          [
            20,
            0.8
          ]
        ]
      },
      "expected_output": 87.5
    },
    {
      "name": "example4",
      "description": "Three packets with one checkpoint. Illustrates DP split-point selection: 2 segments beat 1.",
      "input": {
        "n": 3,
        "k": 1,
        "packets": [
          [
            2,
            0.5
          ],
          [
            4,
            0.5
          ],
          [
            6,
            0.5
          ]
        ]
      },
      "expected_output": 28.0
    },
    {
      "name": "single_packet",
      "description": "Edge case: single packet, no checkpoints. Derivation: E = S/Q = 10/0.9 = 11.1\u0304 \u2192 round6 = 11.111111.",
      "input": {
        "n": 1,
        "k": 0,
        "packets": [
          [
            10,
            0.9
          ]
        ]
      },
      "expected_output": 11.111111
    },
    {
      "name": "single_low_q",
      "description": "Edge case: single packet with low success probability. Derivation: E = S/Q = 7/0.25 = 28.0 exactly.",
      "input": {
        "n": 1,
        "k": 0,
        "packets": [
          [
            7,
            0.25
          ]
        ]
      },
      "expected_output": 28.0
    },
    {
      "name": "perfect_success",
      "description": "All packets have q=1.0 (guaranteed success, no retries). Derivation: E = S_1+S_2+S_3 = 5+10+3 = 18.0 since P(attempt) = 1.",
      "input": {
        "n": 3,
        "k": 0,
        "packets": [
          [
            5,
            1.0
          ],
          [
            10,
            1.0
          ],
          [
            3,
            1.0
          ]
        ]
      },
      "expected_output": 18.0
    },
    {
      "name": "max_checkpoints",
      "description": "k = n-1 so each packet is its own isolated segment. Derivation: E = 5/0.5 + 10/0.5 + 20/0.5 = 10+20+40 = 70.0.",
      "input": {
        "n": 3,
        "k": 2,
        "packets": [
          [
            5,
            0.5
          ],
          [
            10,
            0.5
          ],
          [
            20,
            0.5
          ]
        ]
      },
      "expected_output": 70.0
    },
    {
      "name": "ordering_matters",
      "description": "Input [[10,0.9],[1,0.1]] must be sorted to [[1,0.1],[10,0.9]] (keys: 10/0.1=100 vs 1/0.9=1.11). Derivation: E = (1+0.1\u00b710)/(0.1\u00b70.9) = 2/0.09 = 22.2\u0304 \u2192 round6 = 22.222222.",
      "input": {
        "n": 2,
        "k": 0,
        "packets": [
          [
            10,
            0.9
          ],
          [
            1,
            0.1
          ]
        ]
      },
      "expected_output": 22.222222
    },
    {
      "name": "one_checkpoint",
      "description": "Three packets, k=1 (2 segments). Optimal split [5,10]|[20]: E = (5+0.5\u00b710)/0.25 + 20/0.5 = 40+40 = 80.0. Alternative [5]|[10,20]: E = 10 + (10+0.5\u00b720)/0.25 = 10+80 = 90.",
      "input": {
        "n": 3,
        "k": 1,
        "packets": [
          [
            5,
            0.5
          ],
          [
            10,
            0.5
          ],
          [
            20,
            0.5
          ]
        ]
      },
      "expected_output": 80.0
    },
    {
      "name": "three_packets_k0",
      "description": "Three packets, k=0. Sort keys: (3,0.6)\u21927.5, (7,0.4)\u219211.67, (5,0.8)\u219225. Sorted: [3,7,5]. Expected output verified by reference solution.",
      "input": {
        "n": 3,
        "k": 0,
        "packets": [
          [
            3,
            0.6
          ],
          [
            5,
            0.8
          ],
          [
            7,
            0.4
          ]
        ]
      },
      "expected_output": 43.75
    },
    {
      "name": "three_packets_k2",
      "description": "Three packets, k=2 allows each packet its own segment.",
