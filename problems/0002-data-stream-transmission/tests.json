    },
    {
      "name": "rounding_near_tie",
      "description": "Output precision test: E = 50/0.909 = 55.00550055..., 7th decimal = 5 (rounds up). Python's round(E, 6) = 55.005501; naive truncation floor(E*1e6)/1e6 = 55.005500. Confirms round() is used, not truncation.",
      "input": {
        "n": 1,
        "k": 0,
        "packets": [
          [
            50,
            0.909
          ]
        ]
      },
      "expected_output": 55.005501
    },
