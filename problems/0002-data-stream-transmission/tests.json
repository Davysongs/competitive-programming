    {
      "name": "k_greater_than_n_minus1",
      "description": "k=3 > n-1=1; at most n-1=1 checkpoint is physically possible with 2 packets. Optimal uses 1 checkpoint. Derivation: sorted to [[5,0.1],[20,0.8]], 2 segs: 5/0.1 + 20/0.8 = 50+25 = 75.0. Tests 'at most K' constraint \u2014 a buggy solution using exactly k+1=4 segments for n=2 would fail.",
      "input": {
        "n": 2,
        "k": 3,
        "packets": [
          [
            5,
            0.1
          ],
          [
            20,
            0.8
          ]
        ]
      },
      "expected_output": 75.0
    },
    {
      "name": "k_far_exceeds_n",
      "description": "k=10 >> n-1=2; only 2 checkpoints possible with 3 packets. Optimal uses all 2 checkpoints: each packet its own segment. Derivation: sorted by key, each isolated: 3/0.6 + 5/0.8 + 7/0.4 = 5+6.25+17.5 = 28.75. Tests that excess k is silently capped at n-1.",
      "input": {
        "n": 3,
        "k": 10,
        "packets": [
          [
            3,
            0.6
          ],
          [
            5,
            0.8
          ],
